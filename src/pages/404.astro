---
import Layout from '@/layouts/Layout.astro';
import LinkButton from '@/components/ui/LinkButton.astro';

const PROMPT = 'enzo@developer:~$';
---

<Layout
  title="Page not found — Enzo Monzon"
  description="The page you were looking for doesn’t exist."
  noindex
>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf-grid" aria-hidden="true"></div>

    <div class="container-page">
      <div class="nf-inner">
        <p class="eyebrow enter" style="--d: 0">
          <span class="eyebrow-index">404</span>
          <span>Not found</span>
        </p>
        <h1 id="nf-title" class="nf-title enter" style="--d: 1">This page doesn’t exist.</h1>
        <p class="nf-lede enter" style="--d: 2">The link may be broken, or the page may have moved.</p>

        <div class="nf-term-wrap ticks enter" style="--d: 3">
          <span class="tick tick-tl" aria-hidden="true"></span>
          <span class="tick tick-tr" aria-hidden="true"></span>
          <span class="tick tick-bl" aria-hidden="true"></span>
          <span class="tick tick-br" aria-hidden="true"></span>

          <figure class="nf-term">
            <figcaption class="sr-only">Terminal output</figcaption>
            <div class="nf-term-bar" aria-hidden="true">
              <span class="nf-dots"><span></span><span></span><span></span></span>
              <span class="nf-term-title">enzo@developer: ~</span>
              <span></span>
            </div>
            <div class="nf-term-body">
              <p><span class="nf-prompt">{PROMPT}</span> <span class="nf-cmd">cd <span data-missing-path>/this-page</span></span></p>
              <p class="nf-out"><span class="nf-err">cd:</span> no such file or directory: <span data-missing-path>/this-page</span></p>
              <p aria-hidden="true"><span class="nf-prompt">{PROMPT}</span> <span class="nf-caret"></span></p>
            </div>
          </figure>
        </div>

        <div class="nf-actions enter" style="--d: 4">
          <LinkButton href="/" label="Home" variant="primary" trailing="right" />
          <LinkButton href="/#projects" label="Projects" variant="secondary" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Echo the path that was actually requested (text only, shortened when long).
  let path = window.location.pathname;
  try {
    path = decodeURIComponent(path);
  } catch {
    /* keep the encoded form */
  }
  if (path && path !== '/') {
    const shown = path.length > 48 ? `${path.slice(0, 47)}…` : path;
    document.querySelectorAll<HTMLElement>('[data-missing-path]').forEach((el) => {
      el.textContent = shown;
    });
  }
</script>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 88dvh;
    padding-block: 8rem 6rem;
  }

  .nf-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: -1px -1px;
    mask-image: radial-gradient(ellipse 60% 65% at 50% 45%, #000 15%, transparent 80%);
    pointer-events: none;
  }

  .nf-inner {
    max-width: 40rem;
  }

  .nf-title {
    margin-top: 1.25rem;
    color: var(--fg);
    font-family: var(--font-pixel);
    font-size: clamp(2.25rem, 4vw + 1rem, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .nf-lede {
    max-width: 44ch;
    margin-top: 1rem;
    color: var(--fg-muted);
    font-size: clamp(1.0625rem, 0.35vw + 1rem, 1.1875rem);
    line-height: 1.6;
  }

  /* Terminal: always dark, so its palette is fixed rather than themed. */
  .nf-term-wrap {
    margin-top: 2.5rem;
  }

  .nf-term {
    --t-bar: #111114;
    --t-line: rgb(255 255 255 / 0.07);
    --t-fg: #ededef;
    --t-muted: #a1a1aa;
    --t-title: #8b8b94;
    --t-err: #f08b8b;
    --t-accent: #2ecc71;

    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 0.875rem;
    background: var(--code-bg);
    color: var(--t-muted);
    box-shadow: var(--shadow-float);
  }

  .nf-term-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 2.375rem;
    padding-inline: 0.875rem;
    border-bottom: 1px solid var(--t-line);
    background: var(--t-bar);
    box-shadow: inset 0 1px 0 0 rgb(255 255 255 / 0.05);
  }

  .nf-dots {
    display: flex;
    gap: 0.375rem;
  }

  .nf-dots > span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: #1e1e22;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.09);
  }

  .nf-term-title {
    color: var(--t-title);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .nf-term-body {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.125rem 1.125rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-feature-settings: normal;
    font-variant-ligatures: none;
  }

  .nf-term-body > p {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .nf-prompt {
    color: var(--t-accent);
  }

  .nf-cmd {
    color: var(--t-fg);
  }

  .nf-err {
    color: var(--t-err);
  }

  .nf-out {
    color: var(--t-muted);
  }

  .nf-caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.2em;
    vertical-align: -0.25em;
    background: var(--t-accent);
    animation: caret 1.1s linear infinite;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 64rem) {
    .nf-term-body {
      padding: 1.25rem 1.375rem 1.375rem;
      font-size: 0.8125rem;
      line-height: 1.375rem;
    }
  }
</style>
