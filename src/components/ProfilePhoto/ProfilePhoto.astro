---
/**
 * Hero portrait in a pixel-cornered frame with an offset outline, soft glow,
 * a subtle pointer tilt.
 *
 * The image is read from `site.profilePhoto.src` (a file under public/).
 */
import { site } from '@/data/site';
import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { src, alt } = site.profilePhoto;
---

<figure class={cn('photo', className)} data-tilt>
  <div class="photo-offset" aria-hidden="true"></div>
  <div class="photo-frame">
    <img src={src} alt={alt} width="800" height="1000" loading="eager" decoding="async" fetchpriority="high" />
    <span class="photo-scan" aria-hidden="true"></span>
  </div>
  <span class="px px-tl" aria-hidden="true"></span>
  <span class="px px-tr" aria-hidden="true"></span>
  <span class="px px-bl" aria-hidden="true"></span>
  <span class="px px-br" aria-hidden="true"></span>
</figure>

<style>
  .photo {
    --px: 10px;
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    width: 100%;
    transform: perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 600ms var(--ease-out-expo);
    transform-style: preserve-3d;
  }

  .photo-offset {
    position: absolute;
    inset: 0;
    translate: 14px 14px;
    border: 1px dashed color-mix(in oklab, var(--accent) 55%, transparent);
    border-radius: 1.25rem;
    transition: translate 600ms var(--ease-out-expo);
  }

  .photo:hover .photo-offset {
    translate: 20px 20px;
  }

  .photo-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    box-shadow:
      var(--shadow-float),
      0 30px 80px -40px var(--accent-glow);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease-out-expo);
  }

  .photo:hover .photo-frame img {
    scale: 1.03;
  }

  /* Slow scan line — a CRT nod, very faint */
  .photo-scan {
    position: absolute;
    inset-inline: 0;
    top: -20%;
    height: 20%;
    background: linear-gradient(to bottom, transparent, color-mix(in oklab, var(--accent) 9%, transparent), transparent);
    animation: photo-scan 7s linear infinite;
    pointer-events: none;
  }

  /* Pixel corners */
  .px {
    position: absolute;
    width: var(--px);
    height: var(--px);
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .px::after {
    content: '';
    position: absolute;
    width: var(--px);
    height: var(--px);
    background: inherit;
    opacity: 0.45;
  }

  .px-tl {
    top: calc(var(--px) * -0.5);
    left: calc(var(--px) * -0.5);
  }
  .px-tl::after {
    left: var(--px);
    top: var(--px);
  }
  .px-tr {
    top: calc(var(--px) * -0.5);
    right: calc(var(--px) * -0.5);
  }
  .px-tr::after {
    right: var(--px);
    top: var(--px);
  }
  .px-bl {
    bottom: calc(var(--px) * -0.5);
    left: calc(var(--px) * -0.5);
  }
  .px-bl::after {
    left: var(--px);
    bottom: var(--px);
  }
  .px-br {
    bottom: calc(var(--px) * -0.5);
    right: calc(var(--px) * -0.5);
  }
  .px-br::after {
    right: var(--px);
    bottom: var(--px);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo {
      transform: none;
    }
    .photo-scan {
      display: none;
    }
  }
</style>

<script>
  // Pointer tilt (fine pointers only, motion allowed).
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !still) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      let frame = 0;
      el.addEventListener('pointermove', (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const r = el.getBoundingClientRect();
          const px = (event.clientX - r.left) / r.width - 0.5;
          const py = (event.clientY - r.top) / r.height - 0.5;
          el.style.setProperty('--tilt-y', `${(px * 7).toFixed(2)}deg`);
          el.style.setProperty('--tilt-x', `${(-py * 7).toFixed(2)}deg`);
        });
      });
      el.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        el.style.removeProperty('--tilt-x');
        el.style.removeProperty('--tilt-y');
      });
    });
  }
</script>
