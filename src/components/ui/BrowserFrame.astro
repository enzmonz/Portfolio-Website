---
/**
 * Minimal app-window chrome for desktop screenshots: three dots and a centered
 * title pill (a page name, never a fake URL). The default slot is the image;
 * it is clipped to the frame and fills its width.
 *
 * tone="dark" keeps the chrome dark in both site themes (for screenshots that
 * are always dark); "auto" follows the site theme.
 */
import { cn } from '@/lib/cn';

interface Props {
  title?: string;
  class?: string;
  tone?: 'auto' | 'dark';
}

const { title, class: className, tone = 'auto' } = Astro.props;
---

<div class={cn('window browser-frame', className)} data-tone={tone}>
  <div class="window-bar browser-bar">
    <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
    {
      title && (
        <span class="browser-title">
          <span class="browser-title-text">{title}</span>
        </span>
      )
    }
  </div>
  <div class="browser-viewport">
    <slot />
  </div>
</div>

<style>
  .browser-frame {
    --bar-h: 2.25rem;
    --dots-w: 2.625rem;
    position: relative;
    isolation: isolate;
  }

  /* Always-dark chrome: re-declare the dark tokens locally. */
  .browser-frame[data-tone='dark'] {
    color-scheme: dark;
    --surface: #111113;
    --surface-2: #17171a;
    --surface-3: #1e1e22;
    --border: rgb(255 255 255 / 0.075);
    --border-strong: rgb(255 255 255 / 0.13);
    --fg-subtle: #8b8b94;
    --fg-faint: #5c5c64;
    background: var(--surface-2);
    border-color: var(--border-strong);
  }

  /* Dots left, title centered on the frame (not on the leftover space). The
     equal side tracks keep it centered; the middle track shrinks (ellipsis)
     before it can collide with the dots. */
  .browser-bar {
    display: grid;
    grid-template-columns: minmax(var(--dots-w), 1fr) minmax(0, auto) minmax(var(--dots-w), 1fr);
    gap: 0.75rem;
    height: var(--bar-h);
  }

  .browser-bar .window-dots {
    grid-column: 1;
    justify-self: start;
  }

  .browser-title {
    grid-column: 2;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    min-width: 0;
    max-width: min(26rem, 100%);
    height: 1.375rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.4375rem;
    background: var(--surface-2);
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .browser-title-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-viewport {
    position: relative;
    overflow: hidden;
    background: var(--surface-2);
    /* No inline gap under the image. */
    line-height: 0;
  }

  .browser-viewport :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (width < 40rem) {
    .browser-frame {
      --bar-h: 1.875rem;
      --dots-w: 2.125rem;
    }

    .browser-bar {
      padding-inline: 0.625rem;
    }

    .browser-bar .window-dots {
      gap: 0.3125rem;
    }

    .browser-bar .window-dots > span {
      width: 0.5rem;
      height: 0.5rem;
    }

    .browser-title {
      height: 1.25rem;
      padding-inline: 0.5rem;
      font-size: 0.625rem;
    }
  }
</style>
