---
/**
 * FPS aim trainer: intro (mode, personal best, start) + canvas arena with HUD,
 * overlays and controls. Game logic lives in ./engine.ts, drawing in
 * ./render.ts, wiring in ./controller.ts. No props.
 *
 * Desktop mouse only: on coarse pointers or viewports under 768px the arena is
 * replaced by a notice (CSS media query, mirrored by UNSUPPORTED_QUERY).
 */
import { DEFAULT_MODE, MODES, MODE_ORDER, modeTag } from './modes';
import { MIN_HITS_FOR_RATE_PB } from './storage';

const initial = MODES[DEFAULT_MODE];
const tag = modeTag(initial);
---

<div class="aim" data-aim-root data-phase="idle">
  <!-- ============================== Intro ============================== -->
  <section class="aim-intro" aria-labelledby="aim-title" data-aim-intro>
    <div class="aim-intro-bg" aria-hidden="true"></div>

    <div class="container-page aim-intro-grid">
      <div class="aim-copy">
        <p class="eyebrow enter" style="--d: 0">
          <span class="eyebrow-index">//</span>
          <span>Side project</span>
        </p>
        <h1 id="aim-title" class="aim-title enter" style="--d: 1">
          <span class="block">Mini</span>
          <span class="block">Game<span class="aim-caret" aria-hidden="true"></span></span>
        </h1>
        <p class="aim-lede enter" style="--d: 2">A little side project for the FPS player in me.</p>
        <p class="aim-sub enter" style="--d: 3">Test your reaction time, accuracy, and consistency.</p>
      </div>

      <div class="aim-setup enter" style="--d: 3">
        <fieldset class="aim-modes" data-aim-modes>
          <legend class="aim-k">Mode</legend>
          <div class="aim-seg">
            {
              MODE_ORDER.map((id) => {
                const m = MODES[id];
                return (
                  <label class="aim-seg-opt">
                    <input class="sr-only" type="radio" name="aim-mode" value={id} checked={id === DEFAULT_MODE} />
                    <span class="aim-seg-name">{m.label}</span>
                    <span class="aim-seg-spec">{m.spec}</span>
                  </label>
                );
              })
            }
          </div>
          <p class="aim-mode-desc" data-aim-mode-desc>{initial.description}</p>
        </fieldset>

        <div class="aim-pb">
          <p class="aim-pb-line">
            <span class="aim-k">Personal best</span>
            <span class="aim-pb-dash" aria-hidden="true">—</span>
            <span class="aim-pb-vals">
              <span>Score <span class="aim-pb-v" data-pb="score">—</span></span>
              <span class="aim-pb-sep" aria-hidden="true">·</span>
              <span>Accuracy <span class="aim-pb-v" data-pb="accuracy">—</span></span>
              <span class="aim-pb-sep" aria-hidden="true">·</span>
              <span>Reaction <span class="aim-pb-v" data-pb="reaction">—</span></span>
            </span>
          </p>
          <button type="button" class="aim-pb-reset" data-aim-pb-reset hidden>
            <span data-label>Reset</span>
          </button>
        </div>

        <div class="aim-actions">
          <button type="button" class="btn btn-primary aim-start" data-aim-start>
            <svg viewBox="0 0 8 8" width="14" height="14" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
              <path d="M1 0h2v1h1v1h1v1h1v2H5v1H4v1H3v1H1z"></path>
            </svg>
            <span>Start aim trainer</span>
          </button>
          <p class="aim-keys">
            <span><kbd>Esc</kbd> pause</span>
            <span><kbd>R</kbd> restart</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== Arena ============================== -->
  <section class="aim-arena container-page" aria-labelledby="aim-arena-title" data-aim-arena tabindex="-1">
    <div class="aim-bar">
      <div class="aim-bar-l">
        <h2 id="aim-arena-title" class="aim-bar-title">Arena</h2>
        <span class="aim-bar-mode" data-aim-mode-tag>{tag}</span>
        <span class="status aim-status" data-tone="neutral" data-aim-status>Ready</span>
      </div>
      <div class="aim-controls" role="group" aria-label="Session controls">
        <button type="button" class="aim-ctl" data-aim-pause aria-keyshortcuts="Escape" disabled>
          <span data-label>Pause</span><kbd aria-hidden="true">Esc</kbd>
        </button>
        <button type="button" class="aim-ctl" data-aim-restart aria-keyshortcuts="R" disabled>
          <span>Restart</span><kbd aria-hidden="true">R</kbd>
        </button>
        <button type="button" class="aim-ctl" data-aim-exit disabled>
          <span>Exit</span>
        </button>
      </div>
    </div>

    <div class="aim-stage-wrap ticks">
      <span class="tick tick-tl" aria-hidden="true"></span>
      <span class="tick tick-tr" aria-hidden="true"></span>
      <span class="tick tick-bl" aria-hidden="true"></span>
      <span class="tick tick-br" aria-hidden="true"></span>

      <div class="aim-stage" data-aim-stage data-phase="idle" data-cursor="none">
        <canvas
          class="aim-canvas"
          data-aim-canvas
          role="img"
          aria-label={`Aim trainer arena, ${initial.label} mode. Press Start to begin.`}
          width="1"
          height="1"></canvas>

        <!-- HUD: visual only; results are announced once at the end. -->
        <div class="aim-hud" aria-hidden="true">
          <div class="aim-progress"><span data-hud="progress"></span></div>
          <div class="aim-hud-top">
            <div class="aim-cell aim-cell-l">
              <span class="aim-hk">Score</span>
              <span class="aim-hv" data-hud="score">000</span>
            </div>
            <div class="aim-cell aim-cell-c">
              <span class="aim-hk">Time</span>
              <span class="aim-hv aim-time" data-hud="time">30.0</span>
            </div>
            <div class="aim-cell aim-cell-r">
              <span class="aim-hk">Accuracy</span>
              <span class="aim-hv" data-hud="accuracy">--%</span>
            </div>
          </div>
          <div class="aim-hud-bottom">
            <span><span class="aim-hk">Hits</span> <span data-hud="hits">0</span></span>
            <span><span class="aim-hk">Misses</span> <span data-hud="misses">0</span></span>
            <span><span class="aim-hk">Avg</span> <span data-hud="avg">—</span></span>
            <span class="aim-hud-mode" data-aim-mode-tag>{tag}</span>
          </div>
        </div>

        <!-- Idle -->
        <div class="aim-ov aim-ov-idle" data-aim-overlay="idle">
          <div class="aim-ov-inner">
            <p class="aim-ov-big">Ready</p>
            <p class="aim-ov-text">Click each target as fast as you can. Every click that misses counts.</p>
            <button type="button" class="btn btn-primary aim-ov-btn" data-aim-start>
              <svg viewBox="0 0 8 8" width="12" height="12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
                <path d="M1 0h2v1h1v1h1v1h1v2H5v1H4v1H3v1H1z"></path>
              </svg>
              <span>Start</span>
            </button>
          </div>
        </div>

        <!-- Countdown -->
        <div class="aim-ov aim-ov-count" data-aim-overlay="countdown" aria-hidden="true">
          <div class="aim-ov-inner">
            <p class="aim-hk">Get ready</p>
            <p class="aim-count" data-aim-count>3</p>
          </div>
        </div>

        <!-- Paused -->
        <div class="aim-ov aim-ov-solid" data-aim-overlay="paused" role="group" aria-labelledby="aim-paused-title">
          <div class="aim-ov-inner">
            <h3 id="aim-paused-title" class="aim-ov-big">Paused</h3>
            <p class="aim-ov-text">Press <kbd>Esc</kbd> or Resume to continue.</p>
            <div class="aim-ov-actions">
              <button type="button" class="btn btn-primary aim-ov-btn" data-aim-resume>Resume</button>
              <button type="button" class="btn btn-secondary aim-ov-btn" data-aim-restart>Restart</button>
              <button type="button" class="btn btn-ghost aim-ov-btn" data-aim-exit>Exit</button>
            </div>
          </div>
        </div>

        <!-- Results -->
        <div class="aim-ov aim-ov-solid" data-aim-overlay="ended" role="group" aria-labelledby="aim-end-title">
          <div class="aim-ov-inner aim-end">
            <p class="aim-badge" data-end-badge hidden>
              <span class="aim-badge-px" aria-hidden="true"></span>New personal best
            </p>
            <h3 id="aim-end-title" class="aim-ov-big">Session complete</h3>
            <p class="aim-end-mode" data-aim-mode-tag>{tag}</p>
            <dl class="aim-results">
              <div>
                <dt>Score</dt>
                <dd>
                  <span data-end="score">0</span>
                  <span class="aim-flag" data-end-pb="score" hidden
                    ><span aria-hidden="true">PB</span><span class="sr-only">(new personal best)</span></span
                  >
                </dd>
              </div>
              <div>
                <dt>Accuracy</dt>
                <dd>
                  <span data-end="accuracy">—</span>
                  <span class="aim-flag" data-end-pb="accuracy" hidden
                    ><span aria-hidden="true">PB</span><span class="sr-only">(new personal best)</span></span
                  >
                </dd>
              </div>
              <div>
                <dt>Avg reaction</dt>
                <dd>
                  <span data-end="avg">—</span>
                  <span class="aim-flag" data-end-pb="reaction" hidden
                    ><span aria-hidden="true">PB</span><span class="sr-only">(new personal best)</span></span
                  >
                </dd>
              </div>
              <div>
                <dt>Best reaction</dt>
                <dd><span data-end="best">—</span></dd>
              </div>
              <div>
                <dt>Hits / Misses</dt>
                <dd><span data-end="hits-misses">0 / 0</span></dd>
              </div>
            </dl>
            <p class="aim-end-note" data-end-note hidden>
              Accuracy and reaction records need at least {MIN_HITS_FOR_RATE_PB} hits.
            </p>
            <div class="aim-ov-actions">
              <button type="button" class="btn btn-primary aim-ov-btn" data-aim-again>Play again</button>
              <button type="button" class="btn btn-secondary aim-ov-btn" data-aim-exit>Exit</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="aim-unsupported" role="note">
      <svg class="aim-unsupported-icon" viewBox="0 0 12 18" width="24" height="36" aria-hidden="true" fill="none" stroke="currentColor" shape-rendering="crispEdges">
        <rect x="1.5" y="1.5" width="9" height="15" rx="4.5"></rect>
        <path d="M1.5 7.5h9M6 1.5v6"></path>
        <rect x="5" y="3.5" width="2" height="2.5" fill="currentColor" stroke="none"></rect>
      </svg>
      <div>
        <p class="aim-unsupported-title">Aim Trainer is optimized for desktop mouse input.</p>
        <p class="aim-unsupported-text">Open this page on a computer with a mouse to play. Modes and personal bests are listed above.</p>
      </div>
    </div>

    <p class="aim-nojs">The aim trainer runs in the browser and needs JavaScript enabled.</p>

    <dl class="aim-rules">
      <div>
        <dt>Score</dt>
        <dd>Targets hit in one session.</dd>
      </div>
      <div>
        <dt>Accuracy</dt>
        <dd>Hits ÷ (hits + misses). A click that misses counts as a miss; in Speed mode, so does a target that expires.</dd>
      </div>
      <div>
        <dt>Reaction</dt>
        <dd>Time from a target appearing to your hit. Reaction and accuracy records need at least {MIN_HITS_FOR_RATE_PB} hits.</dd>
      </div>
    </dl>
    <p class="aim-colophon">Built with HTML Canvas and TypeScript, no game engine. Personal bests are stored only in this browser.</p>

    <p class="sr-only" aria-live="polite" data-aim-live></p>
  </section>
</div>

<script>
  import { mountAimTrainer } from './controller';

  const root = document.querySelector<HTMLElement>('[data-aim-root]');
  if (root) {
    let destroy = mountAimTrainer(root);
    window.addEventListener('pagehide', () => destroy());
    // Coming back from the back/forward cache: start fresh.
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      destroy();
      destroy = mountAimTrainer(root);
    });
  }
</script>

<style>
  /* ------------------------------------------------------------------ */
  /* Intro                                                               */
  /* ------------------------------------------------------------------ */

  .aim-intro {
    position: relative;
    isolation: isolate;
    padding-top: clamp(7.5rem, 11vw, 10rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .aim-intro-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 80% at 20% 30%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .aim-intro-grid {
    display: grid;
    gap: 2.75rem;
  }

  @media (width >= 64rem) {
    .aim-intro-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: end;
      gap: 4.5rem;
    }
  }

  .aim-title {
    margin-top: 1.5rem;
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: clamp(4rem, 11vw, 8.5rem);
    line-height: 0.84;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--fg);
  }

  .aim-caret {
    display: inline-block;
    width: 0.24em;
    height: 0.66em;
    margin-left: 0.12em;
    background: var(--pixel);
    box-shadow: 0 0 24px var(--accent-glow);
    animation: caret 1.1s steps(1) infinite;
  }

  .aim-lede {
    margin-top: 1.75rem;
    font-size: clamp(1.125rem, 0.5vw + 1rem, 1.375rem);
    line-height: 1.45;
    color: var(--fg);
    max-width: 34ch;
    letter-spacing: -0.012em;
  }

  .aim-sub {
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 48ch;
  }

  .aim-setup {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .aim-k {
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  /* Mode: native radio group styled as a segmented control */
  .aim-modes {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .aim-modes legend {
    padding: 0;
    margin-bottom: 0.75rem;
  }

  .aim-seg {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.875rem;
    background: var(--surface);
  }

  .aim-seg-opt {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    min-height: 3.75rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out-quart),
      border-color 200ms var(--ease-out-quart);
  }

  .aim-seg-opt:hover {
    background: var(--surface-2);
  }

  .aim-seg-opt:has(input:checked) {
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .aim-seg-opt:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .aim-seg-name {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-pixel);
    font-size: 1.0625rem;
    line-height: 1;
    color: var(--fg);
  }

  .aim-seg-name::before {
    content: '';
    width: 6px;
    height: 6px;
    flex: none;
    background: var(--fg-faint);
    transition: background-color 200ms;
  }

  .aim-seg-opt:has(input:checked) .aim-seg-name {
    color: var(--accent-text);
  }

  .aim-seg-opt:has(input:checked) .aim-seg-name::before {
    background: var(--pixel);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .aim-seg-spec {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.3;
    color: var(--fg-subtle);
  }

  .aim-modes:disabled .aim-seg-opt {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .aim-modes:disabled .aim-seg-opt:hover {
    background: transparent;
  }

  .aim-mode-desc {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--fg-muted);
  }

  /* Personal best: a ruled line, not a box */
  .aim-pb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.9rem;
    border-block: 1px solid var(--border);
  }

  .aim-pb-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .aim-pb-dash {
    color: var(--fg-faint);
  }

  .aim-pb-vals {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }

  .aim-pb-v {
    font-family: var(--font-pixel);
    font-size: 1.0625rem;
    color: var(--fg);
  }

  .aim-pb-sep {
    color: var(--fg-faint);
  }

  .aim-pb-reset {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.25em;
    padding: 0.375rem 0.25rem;
    border-radius: 0.375rem;
    transition: color 200ms;
  }

  .aim-pb-reset:hover {
    color: var(--fg);
  }

  .aim-pb-reset[data-armed] {
    color: var(--warn);
    text-decoration-color: currentColor;
  }

  .aim-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .aim-start {
    height: 3.5rem;
    padding-inline: 1.5rem;
    border-radius: 0.75rem;
    font-family: var(--font-pixel);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .aim-start svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .aim-ov-btn svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .aim-start:disabled,
  .aim-ov-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }

  .aim-keys {
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.375rem;
    padding-inline: 0.3rem;
    margin-right: 0.3rem;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 0.3rem;
    background: var(--surface-2);
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--fg-muted);
  }

  /* ------------------------------------------------------------------ */
  /* Arena                                                               */
  /* ------------------------------------------------------------------ */

  .aim-arena {
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    outline: none;
  }

  .aim-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    min-height: 2.25rem;
    margin-bottom: 0.875rem;
  }

  .aim-bar-l {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
  }

  .aim-bar-title {
    font-family: var(--font-pixel);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .aim-bar-mode {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
    white-space: nowrap;
  }

  .aim-controls {
    display: flex;
    gap: 0.375rem;
    transition: opacity 250ms var(--ease-out-quart);
  }

  .aim[data-phase='idle'] .aim-controls {
    visibility: hidden;
    opacity: 0;
  }

  .aim-ctl {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.5rem;
    background: var(--surface);
    font-family: var(--font-pixel);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition:
      color 200ms,
      border-color 200ms,
      background-color 200ms;
  }

  .aim-ctl kbd {
    margin: 0;
    height: 1.125rem;
    min-width: 1.25rem;
    font-size: 0.625rem;
    color: var(--fg-subtle);
  }

  .aim-ctl:hover:not(:disabled) {
    color: var(--fg);
    border-color: var(--border-hover);
    background: var(--surface-2);
  }

  .aim-ctl:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .aim-ctl[data-state='resume'] {
    color: var(--accent-text);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .aim-stage-wrap {
    position: relative;
  }

  .aim-stage {
    --arena-bg: var(--code-bg);
    --arena-grid: rgb(255 255 255 / 0.042);
    --arena-grid-major: rgb(255 255 255 / 0.11);
    --arena-vignette: rgb(0 0 0 / 0.5);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 22rem;
    max-height: calc(100dvh - 9.5rem);
    border: 1px solid var(--border-strong);
    border-radius: 0.875rem;
    background: var(--arena-bg);
    box-shadow: var(--shadow-float);
    container-type: inline-size;
    user-select: none;
    -webkit-user-select: none;
  }

  :global([data-theme='light']) .aim-stage {
