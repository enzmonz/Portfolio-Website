---
/**
 * 05 — Contact. The closing call to action. Links come from src/data/socials.ts;
 * anything still set to a placeholder renders as a disabled control (LinkButton)
 * or a dashed "to be added" slot.
 */
import Icon from '@/components/ui/Icon.astro';
import LinkButton from '@/components/ui/LinkButton.astro';
import { site } from '@/data/site';
import { socials } from '@/data/socials';
import { isPlaceholder, socialLink } from '@/lib/links';

const email = socialLink('email');
const github = socialLink('github');
const linkedin = socialLink('linkedin');
const address: string | null = isPlaceholder(socials.email) ? null : String(socials.email).trim();
const show: boolean = site.showPlaceholders;
---

<section id="contact" aria-labelledby="contact-title" class="relative section-y">
  <div class="container-page">
    <div class="contact-panel ticks">
      <span class="tick tick-tl" aria-hidden="true"></span>
      <span class="tick tick-tr" aria-hidden="true"></span>
      <span class="tick tick-bl" aria-hidden="true"></span>
      <span class="tick tick-br" aria-hidden="true"></span>

      <div class="contact-backdrop" aria-hidden="true">
        <div class="contact-grid bg-grid"></div>
      </div>

      <!-- Terminal bar -->
      <div class="contact-bar">
        <p class="contact-term" aria-hidden="true">
          <span class="text-accent-text">enzo@developer</span><span class="text-fg-subtle">:~$</span>&nbsp;<span
            class="text-fg-muted">contact --open</span
          ><span class="contact-caret"></span>
        </p>
        {
          site.availability && (
            <p class="flex items-center gap-2.5 text-[0.8125rem] text-fg-muted">
              <span class="live-dot" aria-hidden="true" />
              {site.availability}
            </p>
          )
        }
      </div>

      <!-- Statement + actions -->
      <div class="contact-body">
        <p class="eyebrow" data-reveal>
          <span class="eyebrow-index">05</span>
          <span>Contact</span>
        </p>

        <h2 id="contact-title" class="contact-title mt-7" data-reveal style="--d: 1">
          Let's build something useful.
        </h2>

        <p class="mt-7 max-w-[50ch] text-lede text-fg-muted" data-reveal style="--d: 2">
          I'm open to internships, collaborations, software projects, and opportunities to learn and build.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-reveal style="--d: 3">
          <LinkButton
            href={email.href}
            label="Email me"
            variant="primary"
            icon="mail"
            trailing="right"
            missing={email.missing}
            class="w-full sm:w-auto"
            data-magnetic
          />
          <LinkButton
            href={linkedin.href}
            label="LinkedIn"
            variant="secondary"
            icon="linkedin-brand"
            trailing="up-right"
            external={linkedin.external}
            missing={linkedin.missing}
            class="w-full sm:w-auto"
            data-magnetic
          />
          <LinkButton
            href={github.href}
            label="GitHub"
            variant="ghost"
            icon="github"
            trailing="up-right"
            external={github.external}
            missing={github.missing}
            class="w-full sm:w-auto"
          />
        </div>

        {
          address ? (
            <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2" data-reveal style="--d: 4" data-copy-root>
              <span class="text-label text-fg-subtle">or write to</span>
              <a href={`mailto:${address}`} class="link font-mono text-[0.875rem]">
                {address}
              </a>
              <button type="button" class="copy-btn" data-copy={address} hidden>
                <Icon name="copy" size={13} class="copy-icon" />
                <Icon name="check" size={13} class="check-icon" />
                <span data-copy-label>Copy</span>
                <span class="sr-only"> email address</span>
              </button>
              <span class="sr-only" aria-live="polite" data-copy-status />
            </div>
          ) : (
            show && (
              <p class="placeholder-slot contact-slot mt-8" data-reveal style="--d: 4">
                Email address to be added
              </p>
            )
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initCopy() {
    const root = document.querySelector<HTMLElement>('[data-copy-root]');
    const button = root?.querySelector<HTMLButtonElement>('[data-copy]');
    if (!root || !button) return;
    // Clipboard API needs a secure context; without it the address stays selectable text.
    if (!window.isSecureContext || !navigator.clipboard) return;

    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    let timer = 0;

    const reset = () => {
      delete button.dataset.copied;
      if (label) label.textContent = 'Copy';
    };

    button.hidden = false;
    button.addEventListener('click', async () => {
      window.clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.dataset.copied = 'true';
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = 'Email address copied to clipboard.';
      } catch {
        reset();
        if (status) status.textContent = 'Could not copy. Select the address to copy it manually.';
      }
      timer = window.setTimeout(() => {
        reset();
        if (status) status.textContent = '';
      }, 2200);
    });
  }

  initCopy();
</script>

<style>
  .contact-panel {
    position: relative;
    isolation: isolate;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background:
      radial-gradient(90% 120% at 0% 0%, var(--spotlight), transparent 60%),
      color-mix(in oklab, var(--surface) 72%, transparent);
    box-shadow: var(--shadow-card);
  }

  /* Clipped layer for the grid so the corner ticks can sit outside the frame */
  .contact-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .contact-grid {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 75% 85% at 82% 62%, #000 10%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 75% 85% at 82% 62%, #000 10%, transparent 72%);
  }

  .contact-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem 2rem;
    padding: 0.9375rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  @media (width >= 48rem) {
    .contact-bar {
      padding-inline: 3rem;
    }
  }

  @media (width >= 64rem) {
    .contact-bar {
      padding-inline: 4rem;
    }
  }

  .contact-term {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.25rem;
    white-space: nowrap;
  }

  .contact-caret {
    display: inline-block;
    width: 0.4375rem;
    height: 0.875rem;
    margin-left: 0.3125rem;
    vertical-align: -0.1875rem;
    border-radius: 1px;
    background: var(--accent);
    animation: caret 1.1s linear infinite;
  }

  .contact-body {
    padding: 3.5rem 1.25rem 3.5rem;
  }

  @media (width >= 40rem) {
    .contact-body {
      padding: 4.5rem 2rem;
    }
  }

  @media (width >= 48rem) {
    .contact-body {
      padding: 5.5rem 3rem 5rem;
    }
  }

  @media (width >= 64rem) {
    .contact-body {
      padding: 6.5rem 4rem 5.5rem;
    }
  }

  .contact-title {
    max-width: 16ch;
    font-family: var(--font-pixel);
    font-size: clamp(2.75rem, 6.4vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.005em;
    font-weight: 600;
    text-shadow: 0 0 44px color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--fg);
  }

  .contact-slot {
    display: inline-flex;
    align-items: center;
    padding: 0.4375rem 0.75rem;
    border-radius: 0.625rem;
  }

  /* Copy-to-clipboard */
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    color: var(--fg-muted);
    transition:
      color 200ms var(--ease-out-quart),
      border-color 200ms var(--ease-out-quart),
      background-color 200ms var(--ease-out-quart);
  }

  .copy-btn[hidden] {
    display: none;
  }

  .copy-btn:hover {
    color: var(--fg);
    border-color: var(--border-hover);
  }

  .copy-btn[data-copied] {
    color: var(--accent-text);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .copy-btn :global(.check-icon),
  .copy-btn[data-copied] :global(.copy-icon) {
    display: none;
  }

  .copy-btn[data-copied] :global(.check-icon) {
    display: block;
  }
</style>
