---
/**
 * Layered architecture diagram: node cards joined by thin connectors.
 *
 * - implemented → implemented links carry an animated accent "data flow"
 * - links into/out of a planned node are dashed and static
 * - links touching a partial node are solid and static
 *
 * orientation="auto" stacks vertically below lg and lays out in a row at lg+,
 * but only when the row has room (≈ 8.75rem per node at md, 7.5rem at sm);
 * in a narrower column it stays vertical instead of cramping.
 * Lines draw in when the figure scrolls into view (site.ts sets data-visible).
 */
import Icon from '@/components/ui/Icon.astro';
import TechIcon from '@/components/ui/TechIcon.astro';
import type { IconName } from '@/components/ui/icons';
import type { ArchitectureNode, Availability } from '@/data/projects';
import { techIconFor } from '@/lib/tech';
import { cn } from '@/lib/cn';

interface Props {
  nodes: ArchitectureNode[];
  /** Rendered as a mono label (not a heading — the heading level depends on context). */
  title?: string;
  caption?: string;
  orientation?: 'vertical' | 'horizontal' | 'auto';
  /** 'sm' for project cards, 'md' for detail pages. */
  size?: 'sm' | 'md';
  class?: string;
  /** Accessible name for the list of nodes. */
  label?: string;
  /** Prefix for each node's index (L1, L2 …). */
  indexPrefix?: string;
  /** Schematic stage behind the diagram (border, fine grid, corner ticks). Defaults to true for md. */
  framed?: boolean;
  /**
   * For design-only projects with no code: drops "implemented" checks and the
   * live data-flow animation, so the diagram reads as a model, not a running system.
   */
  conceptual?: boolean;
}

const {
  nodes,
  title,
  caption,
  orientation = 'auto',
  size = 'md',
  class: className,
  label,
  indexPrefix = 'L',
  framed = size === 'md',
  conceptual = false,
} = Astro.props;

type LinkKind = 'live' | 'solid' | 'planned';

const statusOf = (node: ArchitectureNode): Availability => node.status ?? 'implemented';

function linkKind(from: ArchitectureNode, to: ArchitectureNode): LinkKind {
  const a = statusOf(from);
  const b = statusOf(to);
  if (a === 'planned' || b === 'planned') return 'planned';
  if (a === 'implemented' && b === 'implemented' && !conceptual) return 'live';
  return 'solid';
}

/** Brand mark when the label names a known technology, otherwise a role icon. */
const BRANDS = ['React Native', 'React', 'Astro', 'PostgreSQL', 'MySQL', 'Supabase', 'Expo', 'Stripe', 'Node.js'];

function visualFor(text: string): { tech: string } | { icon: IconName } {
  if (techIconFor(text).brand) return { tech: text };
  const l = text.toLowerCase();
  const brand = BRANDS.find((b) => l.includes(b.toLowerCase()));
  if (brand) return { tech: brand };
  if (/payment|billing|checkout/.test(l)) return { icon: 'credit-card' };
  if (/\bapi\b|endpoint/.test(l)) return { icon: 'braces' };
  if (/postgres|database|\bdata\b|\bdb\b|sql|storage/.test(l)) return { icon: 'database' };
  if (/service|system|workflow|server|logic/.test(l)) return { icon: 'workflow' };
  if (/\bui\b|interface|frontend|client|screen/.test(l)) return { icon: 'layout' };
  if (/appointment|booking|schedul|calendar/.test(l)) return { icon: 'calendar' };
  return { icon: 'layers' };
}

/* Geometry (px) — shared by the CSS (via custom properties) and the connector SVGs. */
const G =
  size === 'sm'
    ? { padX: 14, padY: 12, icon: 28, glyph: 15, gx: 32, gy: 20, minNode: 7.5 }
    : { padX: 18, padY: 16, icon: 36, glyph: 18, gx: 48, gy: 28, minNode: 8.75 };

const n = nodes.length;

/* "Auto" only goes horizontal when every node gets at least `minNode` rem.
   The fit wrapper is scaled by k = BASE / needed so a single container query
   (min-width: BASE) answers "is there room?" for any node count. */
const BASE_REM = 12;
const neededRem = n * G.minNode + Math.max(0, n - 1) * (G.gx / 16);
const k = orientation === 'auto' ? Math.min(1, BASE_REM / neededRem) : 1;

const mid = 6; // connector SVG cross-axis center
const h = {
  w: G.gx,
  line: `M0 ${mid} H${G.gx - 1.5}`,
  flow: `M2 ${mid} H${G.gx - 5}`,
  arrow: `M${G.gx - 6} ${mid - 3.5} L${G.gx - 1.5} ${mid} L${G.gx - 6} ${mid + 3.5}`,
};
const v = {
  h: G.gy,
  line: `M${mid} 0 V${G.gy - 1.5}`,
  flow: `M${mid} 2 V${G.gy - 5}`,
  arrow: `M${mid - 3.5} ${G.gy - 6} L${mid} ${G.gy - 1.5} L${mid + 3.5} ${G.gy - 6}`,
};

const links = nodes.slice(1).map((node, i) => linkKind(nodes[i], node));
const legend = [
  links.includes('live') && { kind: 'live' as const, text: 'Implemented' },
  links.includes('solid') && { kind: 'solid' as const, text: 'Partial' },
  links.includes('planned') && { kind: 'planned' as const, text: 'Planned' },
].filter((x): x is { kind: LinkKind; text: string } => Boolean(x));
const showLegend = framed && size === 'md' && legend.length > 1;

const style = [
  `--n:${n}`,
  `--k:${k.toFixed(4)}`,
  `--pad-x:${G.padX}px`,
  `--pad-y:${G.padY}px`,
  `--icon:${G.icon}px`,
  `--gx:${G.gx}px`,
  `--gy:${G.gy}px`,
].join(';');
---

<figure
  class={cn('arch', className)}
  data-orientation={orientation}
  data-size={size}
  data-framed={framed ? '' : undefined}
  data-inview
  style={style}
>
  <div class={cn('arch-stage', framed && 'ticks')}>
    {
      framed && (
        <>
          <span class="tick tick-tl" aria-hidden="true" />
          <span class="tick tick-tr" aria-hidden="true" />
          <span class="tick tick-bl" aria-hidden="true" />
          <span class="tick tick-br" aria-hidden="true" />
        </>
      )
    }

    {
      (title || showLegend) && (
        <div class="arch-head">
          {title && (
            <p class="arch-title text-label">
              <span class="arch-title-mark" aria-hidden="true" />
              {title}
            </p>
          )}
          {showLegend && (
            <ul class="arch-legend" aria-hidden="true">
              {legend.map((item) => (
                <li>
                  <svg width="22" height="6" viewBox="0 0 22 6" class="arch-legend-swatch" data-link={item.kind}>
                    <path class="conn-base" d="M1 3H21" />
                    {item.kind === 'live' && <path class="conn-flow flow-dash" d="M1 3H21" />}
                  </svg>
                  {item.text}
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }

    <div class="arch-fit">
      <ol class="arch-list" aria-label={label ?? 'Architecture'}>
        {
          nodes.map((node, i) => {
            const status = statusOf(node);
            const visual = visualFor(node.label);
            const kind = i > 0 ? links[i - 1] : null;
            return (
              <li class="arch-item" style={`--i:${i}`}>
                {kind && (
                  <>
                    <svg
                      class="conn conn-h"
                      data-link={kind}
                      width={h.w}
                      height="12"
                      viewBox={`0 0 ${h.w} 12`}
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        class={cn('conn-base', kind !== 'planned' && 'draw-line')}
                        d={h.line}
                        pathLength={kind !== 'planned' ? 1 : undefined}
                        style={`--d:${i}`}
                      />
                      {kind === 'live' && <path class="conn-flow flow-dash" d={h.flow} />}
                      <path class="conn-arrow" d={h.arrow} />
                      <circle class="conn-port" cx="0" cy={mid} r="2" />
                    </svg>
                    <svg
                      class="conn conn-v"
                      data-link={kind}
                      width="12"
                      height={v.h}
                      viewBox={`0 0 12 ${v.h}`}
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        class={cn('conn-base', kind !== 'planned' && 'draw-line')}
                        d={v.line}
                        pathLength={kind !== 'planned' ? 1 : undefined}
                        style={`--d:${i}`}
                      />
                      {kind === 'live' && <path class="conn-flow flow-dash" d={v.flow} />}
                      <path class="conn-arrow" d={v.arrow} />
                      <circle class="conn-port" cx={mid} cy="0" r="2" />
                    </svg>
                  </>
                )}

                <div class="node" data-status={status}>
                  <span class="node-icon" aria-hidden="true">
                    {'tech' in visual ? (
                      <TechIcon name={visual.tech} size={G.glyph} />
                    ) : (
                      <Icon name={visual.icon} size={G.glyph} />
                    )}
                  </span>

                  <div class="node-body">
                    <p class="node-label-row">
                      <span class="node-label">{node.label}</span>
                      {status === 'planned' && (
                        <span class="node-tag" data-tone="planned">
                          Planned
                        </span>
                      )}
                      {status === 'partial' && (
                        <span class="node-tag" data-tone="partial">
                          Partial
                        </span>
                      )}
                    </p>
                    {node.detail && <p class="node-detail">{node.detail}</p>}
                  </div>

                  <span class="node-meta">
                    <span class="node-index" aria-hidden="true">{`${indexPrefix}${i + 1}`}</span>
                    {status === 'implemented' && !conceptual && (
                      <span class="node-check">
                        <Icon name="check" size={size === 'sm' ? 9 : 10} strokeWidth={2.75} />
                        <span class="sr-only">Implemented</span>
                      </span>
                    )}
                  </span>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>

  {caption && <figcaption class="arch-caption">{caption}</figcaption>}
</figure>

<style>
  /* ---------------------------------------------------------------- */
  /* Scale                                                             */
  /* ---------------------------------------------------------------- */

  .arch {
    --label-fs: 0.9375rem;
    --detail-fs: 0.8125rem;
    --radius: 0.875rem;
    --node-gap: 0.875rem;
    --body-pt: 1rem;
    min-width: 0;
  }

  .arch[data-size='sm'] {
    --label-fs: 0.8125rem;
    --detail-fs: 0.75rem;
    --radius: 0.75rem;
    --node-gap: 0.625rem;
    --body-pt: 0.75rem;
  }

  /* ---------------------------------------------------------------- */
  /* Stage                                                             */
  /* ---------------------------------------------------------------- */

  .arch-stage {
    position: relative;
  }

  .arch[data-framed] .arch-stage {
    isolation: isolate;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: var(--bg-elevated);
  }

  .arch[data-framed][data-size='sm'] .arch-stage {
    padding: 0.875rem;
    border-radius: 1rem;
  }

  /* Fine drafting grid, faded toward the edges. */
  .arch[data-framed] .arch-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
    mask-image: radial-gradient(ellipse 80% 75% at 50% 45%, #000 35%, transparent 100%);
    pointer-events: none;
  }

  @media (min-width: 48rem) {
    .arch[data-framed][data-size='md'] .arch-stage {
      padding: 1.75rem;
    }
  }

  .arch-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .arch[data-size='sm'] .arch-head {
    margin-bottom: 0.875rem;
  }

  .arch-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--fg-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .arch-title-mark {
    width: 0.4375rem;
    height: 0.4375rem;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    transform: rotate(45deg);
    flex: none;
  }

  .arch-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
  }

  .arch-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .arch-legend-swatch {
    overflow: visible;
  }

  /* ---------------------------------------------------------------- */
  /* Layout: vertical by default, horizontal by orientation / fit      */
  /* ---------------------------------------------------------------- */

  .arch-fit {
    container: arch-fit / inline-size;
    width: calc(100% * var(--k, 1));
  }

  .arch-list {
    --cols: minmax(0, 1fr);
    --row-gap: var(--gy);
    --col-gap: 0px;
    --node-cols: auto minmax(0, 1fr) auto;
    --node-areas: 'icon body meta';
    --node-align: center;
    --node-body-pt: 0px;
    --conn-h: none;
    --conn-v: block;

    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--row-gap) var(--col-gap);
    width: calc(100% / var(--k, 1));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arch[data-orientation='horizontal'] .arch-list {
    --cols: repeat(var(--n), minmax(0, 1fr));
    --row-gap: 0px;
    --col-gap: var(--gx);
    --node-cols: auto minmax(0, 1fr);
    --node-areas: 'icon meta' 'body body';
    --node-align: start;
    --node-body-pt: var(--body-pt);
    --conn-h: block;
    --conn-v: none;
  }

  @media (min-width: 64rem) {
    @container arch-fit (min-width: 12rem) {
      .arch[data-orientation='auto'] .arch-list {
        --cols: repeat(var(--n), minmax(0, 1fr));
        --row-gap: 0px;
        --col-gap: var(--gx);
        --node-cols: auto minmax(0, 1fr);
        --node-areas: 'icon meta' 'body body';
        --node-align: start;
        --node-body-pt: var(--body-pt);
        --conn-h: block;
        --conn-v: none;
      }
    }
  }

  .arch-item {
    position: relative;
    display: flex;
    min-width: 0;
  }

  /* ---------------------------------------------------------------- */
  /* Node                                                              */
  /* ---------------------------------------------------------------- */

  .node {
    position: relative;
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: var(--node-cols);
    grid-template-areas: var(--node-areas);
    align-items: var(--node-align);
    column-gap: var(--node-gap);
    padding: var(--pad-y) var(--pad-x);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .node-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: var(--icon);
    height: var(--icon);
    border: 1px solid var(--border);
    border-radius: calc(var(--icon) * 0.28);
    background: var(--surface-2);
    color: var(--fg);
  }

  .node-body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-width: 0;
    padding-top: var(--node-body-pt);
  }

  .node-label-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
  }

  .node-label {
    color: var(--fg);
    font-size: var(--label-fs);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.012em;
    overflow-wrap: break-word;
  }

  .node-detail {
    color: var(--fg-subtle);
    font-size: var(--detail-fs);
    line-height: 1.45;
    overflow-wrap: break-word;
  }

  .node-meta {
    grid-area: meta;
    align-self: center;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .node-index {
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .node-check {
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-text);
    box-shadow: inset 0 0 0 1px var(--accent-line);
  }

  .arch[data-size='sm'] .node-check {
    width: 0.875rem;
    height: 0.875rem;
  }

  .node-tag {
    display: inline-flex;
    align-items: center;
    height: 1.125rem;
    padding-inline: 0.375rem;
    border: 1px solid transparent;
    border-radius: 0.3125rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .node-tag[data-tone='planned'] {
    border-style: dashed;
    border-color: var(--border-hover);
    color: var(--fg-subtle);
  }

  .node-tag[data-tone='partial'] {
    border-color: color-mix(in oklab, var(--warn) 35%, transparent);
    background: var(--warn-soft);
    color: var(--warn);
  }

  /* Planned: present in the design, not in the code. */
  .node[data-status='planned'] {
    border-style: dashed;
    border-color: var(--border-hover);
    background: transparent;
    box-shadow: none;
  }

  .node[data-status='planned'] .node-icon {
    border-style: dashed;
    border-color: var(--border-strong);
    background: transparent;
    color: var(--fg-subtle);
  }

  .node[data-status='planned'] .node-label {
    color: var(--fg-muted);
  }

  /* ---------------------------------------------------------------- */
  /* Connectors                                                        */
  /* ---------------------------------------------------------------- */

  .conn {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }

  .conn-h {
    display: var(--conn-h);
    top: calc(1px + var(--pad-y) + var(--icon) / 2 - 6px);
    left: calc(-1 * var(--gx));
  }

  .conn-v {
    display: var(--conn-v);
    top: calc(-1 * var(--gy));
    left: calc(1px + var(--pad-x) + var(--icon) / 2 - 6px);
  }

  .conn path,
  .arch-legend-swatch path {
    fill: none;
  }

  .conn-base {
    stroke: var(--border-hover);
    stroke-width: 1;
  }

  .conn-flow {
    stroke: var(--accent);
    stroke-width: 1.25;
    opacity: 0.9;
  }

  .conn-arrow {
    stroke: var(--fg-subtle);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .conn-port {
    fill: var(--surface);
    stroke: var(--border-hover);
    stroke-width: 1;
  }

  [data-link='planned'] .conn-base {
    stroke-dasharray: 2 3;
  }

  .conn[data-link='planned'] .conn-arrow {
    stroke: var(--fg-faint);
  }

  /* ---------------------------------------------------------------- */
  /* Entrance (JS only; the no-JS and reduced-motion state is final)   */
  /* ---------------------------------------------------------------- */

  :global(html.js) .arch .node {
    transition:
      opacity 700ms var(--ease-out-expo),
      transform 700ms var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 140ms);
  }

  :global(html.js) .arch:not([data-visible='true']) .node {
    opacity: 0;
    transform: translateY(6px);
  }

  :global(html.js) .arch .conn-flow,
  :global(html.js) .arch .conn-arrow,
  :global(html.js) .arch .conn-port {
    transition: opacity 500ms var(--ease-out-quart);
    transition-delay: calc(var(--i, 0) * 120ms + 650ms);
  }

  :global(html.js) .arch:not([data-visible='true']) :is(.conn-flow, .conn-arrow, .conn-port) {
    opacity: 0;
  }

  /* Dashed (planned) links can't use the dash-offset draw, so they wipe in. */
  :global(html.js) .arch .conn[data-link='planned'] {
    clip-path: inset(-4px);
    transition: clip-path 900ms var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 120ms + 150ms);
  }

  :global(html.js) .arch:not([data-visible='true']) .conn-h[data-link='planned'] {
    clip-path: inset(-4px 100% -4px -4px);
  }

  :global(html.js) .arch:not([data-visible='true']) .conn-v[data-link='planned'] {
    clip-path: inset(-4px -4px 100% -4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .conn-flow {
      display: none;
    }

    .conn[data-link='live'] .conn-base,
    .arch-legend-swatch[data-link='live'] .conn-base {
      stroke: var(--accent-line);
    }
  }

  /* ---------------------------------------------------------------- */
  /* Caption                                                           */
  /* ---------------------------------------------------------------- */

  .arch-caption {
    max-width: 62ch;
    margin-top: 0.875rem;
    color: var(--fg-subtle);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .arch[data-size='sm'] .arch-caption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }
</style>
