---
/**
 * Hero terminal — a short typed introduction, CSS only.
 *
 * Every line is real DOM text (screen readers and crawlers read it normally).
 * Commands "type" via a stepped width animation measured in `ch`; output lines
 * fade in on a timeline computed below. The sequence waits until the terminal is
 * in view (`data-inview`, flagged by site.ts), plays on load without JS, and
 * renders its final state immediately under reduced motion.
 *
 * The surface is always dark (bg-code) in both themes, so its inner colours are
 * fixed values rather than theme tokens.
 */
import { site } from '@/data/site';
import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const PROMPT = 'enzo@developer:~$';
const TITLE = 'enzo@developer: ~';

type Tone = 'strong' | 'out' | 'key' | 'punc' | 'val';
interface Segment {
  text: string;
  tone: Tone;
}
interface Block {
  cmd: string;
  output: Segment[][];
}

const focus = ['full-stack development', 'system design', 'databases', 'software engineering'];

const script: Block[] = [
  {
    cmd: 'whoami',
    output: [
      [{ text: site.name, tone: 'strong' }],
      [{ text: site.title, tone: 'out' }],
      [{ text: `${site.school.program} @ ${site.school.short}`, tone: 'out' }],
    ],
  },
  {
    cmd: 'cat focus.yml',
    output: [
      [
        { text: 'focus', tone: 'key' },
        { text: ':', tone: 'punc' },
      ],
      ...focus.map((item): Segment[] => [
        { text: '  - ', tone: 'punc' },
        { text: item, tone: 'val' },
      ]),
    ],
  },
];

/* Timeline (ms from the moment the terminal starts playing). Whole sequence ≈ 3s. */
const FIRST_KEY = 650; // first keystroke
const CHAR_MS = 42; // per typed character
const LEAD_MS = 110; // prompt appears → first keystroke
const OUTPUT_DELAY = 120; // last keystroke → first output line
const LINE_STEP = 55; // between output lines
const BLOCK_GAP = 260; // last output line → next prompt

let clock = FIRST_KEY - LEAD_MS;
const timeline = script.map((block, i) => {
  const lineAt = i === 0 ? 0 : clock;
  const typeAt = clock + LEAD_MS;
  const typeMs = block.cmd.length * CHAR_MS;
  const outAt = typeAt + typeMs + OUTPUT_DELAY;
  const lines = block.output.map((segments, j) => ({ segments, at: outAt + j * LINE_STEP }));
  clock = outAt + (block.output.length - 1) * LINE_STEP + BLOCK_GAP;
  return { ...block, lineAt, typeAt, typeMs, lines };
});
const idleAt = clock;
---

<div class={cn('term-wrap ticks', className)}>
  <span class="tick tick-tl" aria-hidden="true"></span>
  <span class="tick tick-tr" aria-hidden="true"></span>
  <span class="tick tick-bl" aria-hidden="true"></span>
  <span class="tick tick-br" aria-hidden="true"></span>

  <figure class="term" data-inview>
    <figcaption class="sr-only">Terminal introduction</figcaption>

    <div class="term-bar" aria-hidden="true">
      <span class="term-dots"><span></span><span></span><span></span></span>
      <span class="term-title">{TITLE}</span>
      <span></span>
    </div>

    <div class="term-body">
      {
        timeline.map((block, i) => (
          <>
            <div class={cn('term-line', i > 0 && 'term-gap term-anim')} style={`--at: ${block.lineAt}ms`}><span class="term-prompt">{PROMPT}</span> <span class="term-cmd" style={`--n: ${block.cmd.length}; --at: ${block.typeAt}ms; --dur: ${block.typeMs}ms`}>{block.cmd}</span></div>
            {block.lines.map((line) => (
              <div class="term-line term-anim" style={`--at: ${line.at}ms`}>{line.segments.map((s) => <span class={`tone-${s.tone}`}>{s.text}</span>)}</div>
            ))}
          </>
        ))
      }
      <div class="term-line term-anim" style={`--at: ${idleAt}ms`} aria-hidden="true"><span class="term-prompt">{PROMPT}</span> <span class="term-caret"></span></div>
    </div>
  </figure>
</div>

<style>
  .term {
    /* Fixed palette: this surface is dark in both themes. */
    --t-bar: #111114;
    --t-line: rgb(255 255 255 / 0.07);
    --t-fg: #ededef;
    --t-val: #c9c9d0;
    --t-muted: #a1a1aa;
    --t-dim: #6e6e78;
    --t-title: #8b8b94;
    --t-key: #7aa2f7;
    --t-accent: #2ecc71;

    position: relative;
    font-size: var(--term-size, inherit);
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 0.875rem;
    background: var(--code-bg);
    color: var(--t-muted);
    box-shadow: var(--shadow-float);
  }

  /* Window bar */
  .term-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 2.375rem;
    padding-inline: 0.875rem;
    border-bottom: 1px solid var(--t-line);
    background: var(--t-bar);
    box-shadow: inset 0 1px 0 0 rgb(255 255 255 / 0.05);
  }

  .term-dots {
    display: flex;
    gap: 0.375rem;
  }

  .term-dots > span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: #1e1e22;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.09);
  }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--t-title);
  }

  /* Body */
  .term-body {
    padding: 0.875rem 1rem 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.25rem;
    /* The page enables Inter's stylistic sets globally; keep the mono face neutral. */
    font-feature-settings: normal;
    font-variant-ligatures: none;
  }

  .term-line {
    white-space: pre;
    letter-spacing: 0;
  }

  .term-gap {
    margin-top: 1.25rem;
  }

  @media (min-width: 64rem) {
    .term-body {
      padding: 1.125rem 1.375rem 1.25rem;
      font-size: 0.8125rem;
      line-height: 1.375rem;
    }

    .term-gap {
      margin-top: 1.375rem;
    }
  }

  .term-prompt {
    color: var(--t-accent);
  }

  .tone-strong {
    color: var(--t-fg);
    font-weight: 500;
  }

  .tone-out {
    color: var(--t-muted);
  }

  .tone-key {
    color: var(--t-key);
  }

  .tone-punc {
    color: var(--t-dim);
  }

  .tone-val {
    color: var(--t-val);
  }

  /* Typed command: width steps one character at a time; a caret rides the right edge while typing. */
  .term-cmd {
    display: inline-block;
    vertical-align: top;
    overflow: hidden;
    width: calc(var(--n) * 1ch + 0.6ch);
    padding-right: 0.6ch;
    color: var(--t-fg);
    background: linear-gradient(var(--t-accent), var(--t-accent)) no-repeat right center / 0 0;
    animation:
      term-type var(--dur) steps(var(--n), end) var(--at) both,
      term-typing calc(var(--dur) + 200ms) linear var(--at) backwards;
  }

  .term-anim {
    animation: term-in 320ms var(--ease-out-quart) var(--at) both;
  }

  .term-caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.2em;
    vertical-align: -0.25em;
    background: var(--t-accent);
    animation: caret 1.1s linear infinite;
  }

  /* Hold the sequence until the terminal scrolls into view (JS only; no-JS plays on load). */
  :global(html.js) .term:not([data-visible='true']) .term-anim,
  :global(html.js) .term:not([data-visible='true']) .term-cmd {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .term-anim,
    .term-cmd,
    .term-caret {
      animation: none;
    }
  }

  @keyframes term-type {
    from {
      width: 0.6ch;
    }
  }

  @keyframes term-typing {
    from,
    to {
      background-size: 0.5ch 1.2em;
    }
  }

  @keyframes term-in {
    from {
      opacity: 0;
      translate: 0 3px;
    }
  }
</style>

<style>
  /* Warm light theme: the surface stays dark, so the accent shifts to a readable coral. */
  :global([data-theme='light']) .term {
    --t-bar: #241718;
    --t-accent: #ff8b7e;
    --t-key: #f5b38a;
  }
</style>
