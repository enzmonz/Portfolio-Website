---
/**
 * Previous / next project cards (wrapping around the list) and a small
 * contact prompt at the end of a project detail page.
 */
import Icon from '@/components/ui/Icon.astro';
import LinkButton from '@/components/ui/LinkButton.astro';
import { projects, type Project } from '@/data/projects';
import { site } from '@/data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const total = projects.length;
const at = Math.max(
  0,
  projects.findIndex((p) => p.slug === project.slug),
);
const prev = projects[(at - 1 + total) % total];
const next = projects[(at + 1) % total];
const showPager = total > 1 && prev && next;
const pad = (n: number) => String(n).padStart(2, '0');

const links = showPager
  ? [
      { dir: 'prev' as const, label: 'Previous', project: prev },
      // With two projects, prev and next are the same; show it once.
      ...(next.slug !== prev.slug ? [{ dir: 'next' as const, label: 'Next', project: next }] : []),
    ]
  : [];
---

<div class="pg">
  <div class="container-page">
    {
      links.length > 0 && (
        <nav aria-label="More projects">
          <div class="pg-head">
            <span>More projects</span>
            <span class="pg-rule" aria-hidden="true" />
            <span class="pg-count">
              {project.index} / {pad(total)}
            </span>
          </div>
          <ul class="pg-list">
            {links.map((link) => (
              <li>
                <a href={`/projects/${link.project.slug}`} class="pg-card card spotlight" data-dir={link.dir} rel={link.dir}>
                  <span class="pg-meta">
                    {link.dir === 'prev' && <Icon name="arrow-left" size={14} class="pg-arrow" />}
                    <span>{link.label}</span>
                    <span class="pg-meta-index" aria-hidden="true">
                      · {link.project.index}
                    </span>
                    {link.dir === 'next' && <Icon name="arrow-right" size={14} class="pg-arrow" />}
                  </span>
                  <span class="pg-title">{link.project.shortTitle}</span>
                  <span class="pg-category">{link.project.category}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="pg-cta" data-reveal>
      <div class="pg-cta-copy">
        <p class="pg-cta-title">Have a question about this project?</p>
        <p class="pg-cta-body">I’m happy to walk through the decisions behind it.</p>
        {
          site.availability && (
            <p class="pg-cta-status">
              <span class="live-dot" aria-hidden="true" />
              {site.availability}
            </p>
          )
        }
      </div>
      <div class="pg-cta-actions">
        <LinkButton href="/#contact" label="Get in touch" variant="primary" trailing="right" />
        <LinkButton href="/#projects" label="All projects" variant="ghost" />
      </div>
    </div>
  </div>
</div>

<style>
  .pg {
    padding-bottom: 6rem;
    border-top: 1px solid var(--border);
    padding-top: 4rem;
  }

  .pg-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pg-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--border-strong), var(--border) 60%, transparent);
  }

  .pg-count {
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .pg-list {
    display: grid;
    gap: 1rem;
  }

  .pg-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
  }

  .pg-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .pg-card:active {
    transform: translateY(0);
  }

  .pg-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pg-meta-index {
    font-variant-numeric: tabular-nums;
  }

  .pg-card :global(.pg-arrow) {
    flex: none;
    transition:
      transform 400ms var(--ease-out-expo),
      color 200ms var(--ease-out-quart);
  }

  .pg-card:hover :global(.pg-arrow) {
    color: var(--accent-text);
  }

  .pg-card[data-dir='prev']:hover :global(.pg-arrow) {
    transform: translateX(-3px);
  }

  .pg-card[data-dir='next']:hover :global(.pg-arrow) {
    transform: translateX(3px);
  }

  .pg-title {
    margin-top: 2rem;
    color: var(--fg);
    font-family: var(--font-pixel);
    font-size: clamp(1.5rem, 1vw + 1.15rem, 1.875rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .pg-category {
    margin-top: 0.375rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  /* Contact prompt */
  .pg-cta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px dashed var(--border);
  }

  .pg-cta-title {
    color: var(--fg);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .pg-cta-body {
    margin-top: 0.375rem;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .pg-cta-status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .pg-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .pg-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pg-card[data-dir='next'] {
      align-items: flex-end;
      text-align: right;
    }

    /* A lone card (two-project list) keeps the left column. */
    .pg-list > li:only-child {
      grid-column: 1;
    }
  }

  @media (min-width: 48rem) {
    .pg {
      padding-top: 5rem;
      padding-bottom: 8rem;
    }

    .pg-card {
      padding: 1.75rem 2rem;
    }

    .pg-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }

    .pg-cta-actions {
      flex: none;
    }
  }
</style>
