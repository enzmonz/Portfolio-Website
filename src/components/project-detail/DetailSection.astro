---
/**
 * One numbered section of a project detail page: hairline rule with a short
 * registration segment, mono index + h2, then the slotted content.
 */
import { cn } from '@/lib/cn';

interface Props {
  /** Two-digit mono index, e.g. "01". */
  index: string;
  title: string;
  /** Id for the h2; the section is labelled by it. */
  id: string;
  class?: string;
}

const { index, title, id, class: className } = Astro.props;
---

<section aria-labelledby={id} class={cn('ds', className)}>
  <div class="ds-head" data-reveal>
    <span class="ds-index" aria-hidden="true">{index}</span>
    <h2 id={id} class="ds-title">{title}</h2>
  </div>
  <div class="ds-body">
    <slot />
  </div>
</section>

<style>
  .ds {
    position: relative;
    padding-block: 3rem;
    border-top: 1px solid var(--border);
  }

  /* A slightly stronger segment at the start of the rule. */
  .ds::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2rem;
    height: 1px;
    background: var(--border-hover);
  }

  /* The body grid draws the first rule across both columns. */
  .ds:first-child {
    border-top: 0;
  }

  /* The page body supplies the closing space. */
  .ds:last-child {
    padding-bottom: 0;
  }

  .ds-head {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
  }

  .ds-index {
    flex: none;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .ds-title {
    color: var(--fg);
    font-family: var(--font-pixel);
    font-size: clamp(1.625rem, 1vw + 1.25rem, 2.125rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .ds-body {
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .ds {
      padding-block: 4rem;
    }

    .ds-body {
      margin-top: 2.5rem;
    }
  }
</style>
