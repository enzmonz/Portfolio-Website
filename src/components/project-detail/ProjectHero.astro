---
/**
 * Project detail header: back link, meta row (index / category / status / year),
 * the h1 (shares a view-transition name with the showcase card title), headline
 * lede, summary, repository / demo links and the status note.
 */
import Icon from '@/components/ui/Icon.astro';
import LinkButton from '@/components/ui/LinkButton.astro';
import StatusPill from '@/components/ui/StatusPill.astro';
import type { Project } from '@/data/projects';
import { optionalLink } from '@/lib/links';

interface Props {
  project: Project;
  /** Number of projects, for the "01 / 04" index. */
  total: number;
}

const { project, total } = Astro.props;

const github = optionalLink('GitHub', project.links.github, 'Repository link not added yet');
const demo = optionalLink('Live demo', project.links.demo, 'No live demo yet');
const pad = (n: number) => String(n).padStart(2, '0');
const position = Number.parseInt(project.index, 10);
---

<header class="ph relative isolate pt-28 pb-14 md:pb-20 lg:pt-36">
  <div class="ph-grid" aria-hidden="true"></div>

  <div class="container-page">
    <a href="/#projects" class="ph-back enter" style="--d: 0">
      <Icon name="arrow-left" size={16} class="ph-back-arrow" />
      <span>All projects</span>
    </a>

    <div class="ph-meta enter" style="--d: 1">
      <p class="ph-meta-group">
        <span class="ph-index" aria-hidden="true"><span class="text-accent-text">{project.index}</span> / {pad(total)}</span>
        <span class="sr-only">Project {Number.isNaN(position) ? project.index : position} of {total}:</span>
        <span class="ph-rule" aria-hidden="true"></span>
        <span class="ph-category">{project.category}</span>
      </p>
      <p class="ph-meta-group">
        <StatusPill status={project.status} />
        <span class="ph-year"><span class="sr-only">Year </span>{project.year}</span>
      </p>
    </div>

    <h1 class="ph-title" style={`view-transition-name: pt-${project.slug}`}>{project.title}</h1>

    <div class="ph-columns">
      <div class="ph-copy">
        <p class="ph-headline enter" style="--d: 2">{project.headline}</p>
        <p class="ph-summary enter" style="--d: 3">{project.summary}</p>
      </div>

      <div class="ph-side enter" style="--d: 4">
        <div class="flex flex-wrap gap-3">
          <LinkButton
            href={github.href}
            label="GitHub"
            icon="github"
            variant={github.href ? 'primary' : 'secondary'}
            trailing={github.href ? 'up-right' : 'none'}
            external={github.external}
            missing={github.missing}
          />
          <LinkButton
            href={demo.href}
            label="Live demo"
            variant="secondary"
            trailing={demo.href ? 'up-right' : 'none'}
            external={demo.external}
            missing={demo.missing}
          />
        </div>

        {
          project.statusNote && (
            <div class="ph-note">
              <svg
                class="ph-note-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <circle cx="12" cy="12" r="9.25" />
                <path d="M12 16.25v-5" />
                <path d="M12 7.75h.01" />
              </svg>
              <p>
                <span class="ph-note-label">Status</span>
                <span class="sr-only">: </span>
                {project.statusNote}
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</header>

<style>
  /* Fine grid that fades out away from the title. */
  .ph-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: -1px -1px;
    mask-image: radial-gradient(ellipse 80% 75% at 25% 0%, #000 10%, transparent 75%);
    pointer-events: none;
  }

  .ph-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    margin-left: -0.625rem;
    padding-inline: 0.625rem;
    border-radius: 0.625rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition:
      color 200ms var(--ease-out-quart),
      background-color 200ms var(--ease-out-quart);
  }

  .ph-back:hover {
    color: var(--fg);
    background: var(--surface-2);
  }

  .ph-back :global(.ph-back-arrow) {
    transition: transform 300ms var(--ease-out-expo);
  }

  .ph-back:hover :global(.ph-back-arrow) {
    transform: translateX(-3px);
  }

  .ph-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2.5rem;
  }

  .ph-meta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.02em;
  }

  .ph-index {
    color: var(--fg-subtle);
    font-variant-numeric: tabular-nums;
  }

  .ph-rule {
    width: 1.75rem;
    height: 1px;
    background: linear-gradient(to right, var(--border-strong), transparent);
  }

  .ph-category {
    color: var(--fg-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ph-year {
    color: var(--fg-subtle);
    font-variant-numeric: tabular-nums;
  }

  .ph-title {
    max-width: 20ch;
    margin-top: 1.5rem;
    color: var(--fg);
    font-family: var(--font-pixel);
    font-size: clamp(2.5rem, 5vw + 0.5rem, 4.75rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.005em;
  }

  .ph-columns {
    display: grid;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  .ph-headline {
    max-width: 30ch;
    color: var(--fg);
    font-size: clamp(1.3125rem, 1vw + 1rem, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .ph-summary {
    max-width: 62ch;
    margin-top: 1.25rem;
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .ph-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .ph-note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 34rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .ph-note-icon {
    flex: none;
    margin-top: 0.1875rem;
    color: var(--info);
  }

  .ph-note-label {
    margin-right: 0.5rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .ph-summary {
      font-size: 1.0625rem;
    }
  }

  @media (min-width: 64rem) {
    .ph-columns {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 4rem;
      margin-top: 2.5rem;
    }

    .ph-side {
      padding-left: 2.5rem;
      border-left: 1px solid var(--border);
    }
  }
</style>
