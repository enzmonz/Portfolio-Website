---
/**
 * "Project details" spec card for the detail page sidebar: category, status,
 * year, stack (with planned / partial markers), links and the Cinnabyte credit.
 * Sticky beside the content at lg+ when the viewport is tall enough to show it whole.
 */
import { Image } from 'astro:assets';
import mascot from '@/assets/brand/cinnabyte-mascot.png';
import LinkButton from '@/components/ui/LinkButton.astro';
import StatusPill from '@/components/ui/StatusPill.astro';
import TechChip from '@/components/ui/TechChip.astro';
import type { Project } from '@/data/projects';
import { optionalLink } from '@/lib/links';
import { cn } from '@/lib/cn';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;

const github = optionalLink('GitHub', project.links.github, 'Repository link not added yet');
const demo = optionalLink('Live demo', project.links.demo, 'No live demo yet');
const titleId = `${project.slug}-details-title`;
---

<aside class={cn('pa', className)} aria-labelledby={titleId}>
  <div class="pa-card card" data-reveal>
    <div class="pa-top">
      <h2 id={titleId} class="pa-title">Project details</h2>
      <span class="pa-index" aria-hidden="true">{project.index}</span>
    </div>

    <dl class="pa-list">
      <div class="pa-row">
        <dt>Category</dt>
        <dd>{project.category}</dd>
      </div>
      <div class="pa-row">
        <dt>Status</dt>
        <dd><StatusPill status={project.status} /></dd>
      </div>
      <div class="pa-row">
        <dt>Year</dt>
        <dd class="tabular-nums">{project.year}</dd>
      </div>
      <div class="pa-row pa-row--block">
        <dt>Stack</dt>
        <dd>
          <ul class="pa-chips">
            {
              project.stack.map((tech) => (
                <li>
                  <TechChip name={tech.name} status={tech.status} />
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
      <div class="pa-row pa-row--block">
        <dt>Links</dt>
        <dd class="pa-links">
          <LinkButton
            href={github.href}
            label="GitHub"
            icon="github"
            size="sm"
            trailing={github.href ? 'up-right' : 'none'}
            external={github.external}
            missing={github.missing}
          />
          <LinkButton
            href={demo.href}
            label="Live demo"
            size="sm"
            trailing={demo.href ? 'up-right' : 'none'}
            external={demo.external}
            missing={demo.missing}
          />
        </dd>
      </div>
    </dl>

    {
      project.cinnabyte && (
        <p class="pa-org">
          <span class="pa-org-mark" aria-hidden="true">
            <Image src={mascot} alt="" width={28} densities={[1, 2, 3]} class="pa-mascot" />
          </span>
          <span>
            Built under <span class="pa-org-name">Cinnabyte</span>
          </span>
        </p>
      )
    }
  </div>
</aside>

<style>
  .pa {
    min-width: 0;
  }

  .pa-card {
    padding: 1.5rem;
  }

  /* Sticky only where the whole card fits under the fixed nav. */
  @media (min-width: 64rem) and (min-height: 50rem) {
    .pa-card {
      position: sticky;
      top: 7rem;
    }
  }

  @media (min-width: 64rem) {
    .pa {
      padding-top: 4rem;
    }
  }

  .pa-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
  }

  .pa-title {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pa-index {
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .pa-row {
    display: grid;
    grid-template-columns: 4.75rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-height: 3rem;
    padding-block: 0.625rem;
    border-top: 1px solid var(--border);
  }

  .pa-row dt {
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pa-row dd {
    min-width: 0;
    color: var(--fg);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .pa-row--block {
    display: block;
    padding-block: 0.875rem 1rem;
  }

  .pa-row--block dd {
    margin-top: 0.75rem;
  }

  .pa-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .pa-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pa-org {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .pa-org-mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    background: var(--surface-2);
  }

  /* Rendered at its generated size (1x/2x/3x) so the pixel art stays crisp. */
  .pa-org-mark :global(.pa-mascot) {
    width: 1.75rem;
    height: auto;
    image-rendering: pixelated;
    translate: 1px 1px;
  }

  .pa-org-name {
    color: var(--fg);
    font-weight: 500;
  }

  @media (min-width: 48rem) {
    .pa-card {
      padding: 1.75rem;
    }
  }

  @media (min-width: 64rem) {
    .pa-card {
      padding: 1.5rem;
    }
  }
</style>
