---
/**
 * What is built vs what is planned. "Built" sits on a solid panel with accent
 * checks; "Planned" on a dashed panel with dashed circles and muted text.
 */
import Icon from '@/components/ui/Icon.astro';
import { cn } from '@/lib/cn';

interface Props {
  scope: { implemented: string[]; planned: string[] };
  class?: string;
}

const { scope, class: className } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const groups = [
  { kind: 'built', title: 'Built', items: scope.implemented },
  { kind: 'planned', title: 'Planned', items: scope.planned },
].filter((group) => group.items.length > 0);
---

<div class={cn('sc', groups.length > 1 && 'sc--split', className)}>
  {
    groups.map((group, g) => (
      <div class="sc-panel" data-kind={group.kind} data-reveal style={`--d: ${g}`}>
        <h3 class="sc-head">
          <span>{group.title}</span>
          <span class="sc-count">
            {pad(group.items.length)}
            <span class="sr-only"> items</span>
          </span>
        </h3>
        <ul class="sc-list">
          {group.items.map((item) => (
            <li class="sc-item">
              <span class="sc-mark" aria-hidden="true">
                {group.kind === 'built' ? (
                  <Icon name="check" size={11} strokeWidth={2.5} />
                ) : (
                  <svg viewBox="0 0 16 16" width="16" height="16" focusable="false">
                    <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="2.2 2" />
                  </svg>
                )}
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .sc {
    display: grid;
    gap: 1rem;
  }

  .sc-panel {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .sc-panel[data-kind='planned'] {
    border: 1px dashed var(--border-strong);
    background: transparent;
    box-shadow: none;
  }

  .sc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sc-panel[data-kind='planned'] .sc-head {
    border-bottom-style: dashed;
    color: var(--fg-muted);
  }

  .sc-count {
    color: var(--fg-subtle);
    font-weight: 400;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .sc-list {
    display: grid;
    gap: 0.875rem;
    margin-top: 1.25rem;
  }

  .sc-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .sc-panel[data-kind='planned'] .sc-item {
    color: var(--fg-muted);
  }

  .sc-mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.1875rem;
    border-radius: 999px;
    color: var(--accent-text);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent-line);
  }

  .sc-panel[data-kind='planned'] .sc-mark {
    color: var(--fg-subtle);
    background: transparent;
    box-shadow: none;
  }

  .sc-panel[data-kind='planned'] .sc-mark svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  @media (min-width: 48rem) {
    .sc--split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .sc-panel {
      padding: 1.75rem;
    }
  }
</style>
