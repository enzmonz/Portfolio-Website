---
/**
 * 02 — About, including the technical profile (skills live here, not in a
 * separate section). Typographic and flowing rather than a grid of boxes.
 * Skills come from src/data/skills.ts; "used in" is computed from projects.ts.
 */
import SectionHeader from '@/components/ui/SectionHeader.astro';
import TechIcon from '@/components/ui/TechIcon.astro';
import { site } from '@/data/site';
import { primaryFocus, projectsUsing, skillGroups } from '@/data/skills';

const profile: { key: string; value: string; sub?: string; live?: boolean }[] = [
  { key: 'Education', value: `${site.school.program} · ${site.school.short}`, sub: site.school.name },
  { key: 'Currently', value: 'Associate Founder, Cinnabyte' },
];

const usage = (name: string) => {
  const group = skillGroups.flatMap((g) => g.skills).find((s) => s.name === name);
  return group ? projectsUsing(group) : [];
};
---

<section id="about" aria-labelledby="about-title" class="about relative section-y overflow-x-clip">
  <p class="bg-word" aria-hidden="true">About</p>

  <div class="container-page relative">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-16">
      <div class="lg:col-span-5">
        <SectionHeader
          index="02"
          eyebrow="About"
          id="about-title"
          title={'Learning by building <span class="text-fg-subtle">real software.</span>'}
        />

        <dl class="profile mt-10" data-reveal style="--d: 2">
          {
            profile.map((row) => (
              <div class="profile-row">
                <dt>{row.key}</dt>
                <dd>
                  <span class="inline-flex items-center gap-2">
                    {row.live && <span class="live-dot" aria-hidden="true" />}
                    {row.value}
                  </span>
                  {row.sub && <span class="profile-sub">{row.sub}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="lg:col-span-7 lg:pt-14">
        <div class="flex flex-col gap-5">
          <p class="text-lede text-fg" data-reveal>
            I turn ideas into web and mobile apps at <a href="#experience" class="link">Cinnabyte</a>.
          </p>
          <p class="text-base leading-relaxed text-fg-muted md:text-[1.0625rem]" data-reveal style="--d: 1">
            Through <a href="#projects" class="link">hands-on projects</a>, I'm strengthening my foundations in
            programming, database design, and software architecture.
          </p>
        </div>

      </div>
    </div>

    <!-- Technical profile -->
    <div class="tech mt-20 md:mt-24" data-tech-profile>
      <div class="tech-head" data-reveal>
        <p class="eyebrow"><span class="eyebrow-index">//</span><span>Technical profile</span></p>
        <h3 class="tech-focus">{primaryFocus.label}</h3>
        <p class="mt-3 max-w-[46ch] text-fg-muted">{primaryFocus.description}</p>
      </div>

      <dl class="groups" data-reveal style="--d: 2">
        {
          skillGroups.map((group) => (
            <div class="group-row">
              <dt>
                <span>{group.label}</span>
                <span class="group-count">{String(group.skills.length).padStart(2, '0')}</span>
              </dt>
              <dd>
                <ul class="group-skills">
                  {group.skills.map((skill) => {
                    const used = usage(skill.name);
                    const usedText = used.map((u) => u.title).join(', ');
                    return (
                      <li class="tok" data-skill={skill.name} data-used={used.map((u) => u.title).join(' · ')} title={usedText ? `Used in ${usedText}` : undefined}>
                        <TechIcon name={skill.name} size={14} />
                        {skill.name}
                        {usedText && <span class="sr-only"> (used in {usedText})</span>}
                      </li>
                    );
                  })}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="tech-trace" aria-hidden="true" data-tech-trace>
        <span class="text-accent-text">›</span> <span data-tech-trace-text>Hover a technology to trace where it's used</span>
      </p>
    </div>
  </div>
</section>

<style>
  .bg-word {
    position: absolute;
    top: 0.75rem;
    right: -2rem;
    font-family: var(--font-pixel);
    font-size: clamp(5rem, 13vw, 12rem);
    line-height: 0.8;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--fg) 9%, transparent);
    pointer-events: none;
    user-select: none;
  }

  /* Profile: an unboxed spec sheet */
  .profile {
    border-top: 1px solid var(--border-strong);
  }

  .profile-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
  }

  .profile-row dt {
    padding-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .profile-row dd {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-weight: 500;
    color: var(--fg);
  }

  .profile-sub {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--fg-subtle);
  }

  /* Technical profile */
  .tech {
    display: grid;
    gap: 2.5rem;
    border-top: 1px solid var(--border-strong);
    padding-top: 2.5rem;
  }

  @media (width >= 64rem) {
    .tech {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 4rem;
      row-gap: 2rem;
    }

    .tech-head {
      grid-row: span 2;
    }
  }

  .tech-focus {
    margin-top: 1.5rem;
    font-family: var(--font-pixel);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--fg);
    text-shadow: 0 0 36px color-mix(in oklab, var(--accent) 18%, transparent);
  }

  .groups {
    display: flex;
    flex-direction: column;
  }

  .group-row {
    display: grid;
    gap: 0.5rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--border);
  }

  @media (width >= 40rem) {
    .group-row {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: baseline;
    }
  }

  .group-row dt {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .group-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--fg-faint);
  }

  .group-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.125rem;
  }

  .tok {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg);
    transition:
      color 200ms,
      translate 300ms var(--ease-out-expo),
      opacity 200ms;
  }

  .tok :global(svg) {
    color: var(--fg-subtle);
    transition: color 200ms;
  }

  :global([data-tech-profile][data-tracing]) .tok {
    opacity: 0.4;
  }

  :global([data-tech-profile][data-tracing]) .tok.is-lit {
    opacity: 1;
    color: var(--accent-text);
    translate: 0 -1px;
  }

  .tok.is-lit :global(svg) {
    color: var(--accent-text);
  }

  .tech-trace {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
    min-height: 1.25rem;
  }

  @media (hover: none) {
    .tech-trace {
      display: none;
    }
  }
</style>

<script>
  // Hovering a technology lights it everywhere in the profile and shows where it's used.
  const root = document.querySelector<HTMLElement>('[data-tech-profile]');
  const text = root?.querySelector<HTMLElement>('[data-tech-trace-text]');
  if (root && text && matchMedia('(hover: hover)').matches) {
    const idle = text.textContent ?? '';
    const tokens = Array.from(root.querySelectorAll<HTMLElement>('[data-skill]'));
    const usedBy = new Map<string, string>();
    tokens.forEach((t) => t.dataset.used && usedBy.set(t.dataset.skill!, t.dataset.used));
    tokens.forEach((token) => {
      token.addEventListener('pointerenter', () => {
        const name = token.dataset.skill!;
        root.dataset.tracing = '';
        tokens.forEach((t) => t.classList.toggle('is-lit', t.dataset.skill === name));
        const used = usedBy.get(name);
        text.textContent = used ? `${name} → used in ${used}` : `${name} → part of the toolkit`;
      });
      token.addEventListener('pointerleave', () => {
        delete root.dataset.tracing;
        tokens.forEach((t) => t.classList.remove('is-lit'));
        text.textContent = idle;
      });
    });
  }
</script>
