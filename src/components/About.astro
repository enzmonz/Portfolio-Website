---
/**
 * 02 — About, including the technical profile (skills live here, not in a
 * separate section). Typographic and flowing rather than a grid of boxes.
 * Skills come from src/data/skills.ts; "used in" is computed from projects.ts.
 */
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import TechIcon from '@/components/ui/TechIcon.astro';
import type { IconName } from '@/components/ui/icons';
import { site } from '@/data/site';
import { primaryFocus, projectsUsing, skillGroups } from '@/data/skills';

const profile: { key: string; value: string; sub?: string; live?: boolean }[] = [
  { key: 'Education', value: `${site.school.program} · ${site.school.short}`, sub: site.school.name },
  { key: 'Role', value: site.title },
  { key: 'Focus', value: primaryFocus.label },
  { key: 'Currently', value: 'Associate Founder, Cinnabyte' },
  ...(site.availability ? [{ key: 'Open to', value: 'Internships & collaborations', live: true }] : []),
];

const developing: { label: string; icon: IconName }[] = [
  { label: 'Programming', icon: 'code' },
  { label: 'Data structures', icon: 'git-branch' },
  { label: 'System design', icon: 'workflow' },
  { label: 'Full-stack development', icon: 'layers' },
  { label: 'Database systems', icon: 'database' },
];

const lookingFor = ['Real-world projects', 'Internships', 'Collaboration', 'Building practical software'];

const usage = (name: string) => {
  const group = skillGroups.flatMap((g) => g.skills).find((s) => s.name === name);
  return group ? projectsUsing(group) : [];
};
---

<section id="about" aria-labelledby="about-title" class="about relative section-y overflow-x-clip">
  <p class="bg-word" aria-hidden="true">About</p>

  <div class="container-page relative">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-16">
      <div class="lg:col-span-5">
        <SectionHeader
          index="02"
          eyebrow="About"
          id="about-title"
          title={'Learning by building <span class="text-fg-subtle">real software.</span>'}
        />

        <dl class="profile mt-10" data-reveal style="--d: 2">
          {
            profile.map((row) => (
              <div class="profile-row">
                <dt>{row.key}</dt>
                <dd>
                  <span class="inline-flex items-center gap-2">
                    {row.live && <span class="live-dot" aria-hidden="true" />}
                    {row.value}
                  </span>
                  {row.sub && <span class="profile-sub">{row.sub}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="lg:col-span-7 lg:pt-14">
        <div class="flex flex-col gap-5">
          <p class="text-lede text-fg" data-reveal>
            I'm a Computer Science student at {site.school.name} ({site.school.short}) with a growing passion for software
            development, problem-solving, and technology-driven solutions.
          </p>
          <p class="text-base leading-relaxed text-fg-muted md:text-[1.0625rem]" data-reveal style="--d: 1">
            Right now I'm strengthening my foundations in programming, data structures, and system design, mostly by
            applying them to <a href="#projects" class="link">real projects</a>. Most of those come out of{' '}
            <a href="#experience" class="link">Cinnabyte</a>, where I'm an Associate Founder, and so far they span
            internal tools, e-commerce, mobile apps, and database design.
          </p>
          <p class="text-base leading-relaxed text-fg-muted md:text-[1.0625rem]" data-reveal style="--d: 2">
            Next, I'm looking for real-world experience through internships, collaborations, and projects where I can
            learn from experienced developers and help build practical software.
          </p>
        </div>

        <div class="mt-10 grid gap-8 sm:grid-cols-2" data-reveal style="--d: 3">
          <div>
            <h3 class="mini-title">Currently developing</h3>
            <ul class="mt-4 flex flex-col">
              {
                developing.map((d, i) => (
                  <li class="dev-row">
                    <span class="font-mono text-[0.6875rem] text-fg-subtle">{String(i + 1).padStart(2, '0')}</span>
                    <Icon name={d.icon} size={15} class="text-accent-text" />
                    <span>{d.label}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="mini-title">Looking for</h3>
            <p class="mt-4 text-[0.9375rem] leading-[1.9] text-fg-muted">
              {
                lookingFor.map((item, i) => (
                  <>
                    <span class="text-fg">{item}</span>
                    {i < lookingFor.length - 1 && <span class="sep" aria-hidden="true"> / </span>}
                    {i < lookingFor.length - 1 && <span class="sr-only">,</span>}
                  </>
                ))
              }
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Technical profile -->
    <div class="tech mt-20 md:mt-24" data-tech-profile>
      <div class="tech-head" data-reveal>
        <p class="eyebrow"><span class="eyebrow-index">//</span><span>Technical profile</span></p>
        <p class="tech-focus-label">Current focus</p>
        <h3 class="tech-focus">{primaryFocus.label}</h3>
        <p class="mt-3 max-w-[46ch] text-fg-muted">{primaryFocus.description}</p>
      </div>

      <!-- The stack, as one flowing line: Interface → API → Data -->
      <ol class="layers" aria-label="Full-stack layers" data-reveal style="--d: 1" data-inview>
        {
          primaryFocus.layers.map((layer, i) => (
            <li class="layer">
              <span class="layer-name">
                <span class="font-mono text-[0.6875rem] text-fg-subtle">L{i + 1}</span>
                {layer.label}
              </span>
              <span class="layer-skills">
                {layer.skills.map((name) => (
                  <span class="tok" data-skill={name}>
                    <TechIcon name={name} size={13} />
                    {name}
                  </span>
                ))}
              </span>
              {i < primaryFocus.layers.length - 1 && (
                <svg class="layer-link" viewBox="0 0 40 12" aria-hidden="true">
                  <path class="draw-line" pathLength="1" d="M0 6 H34" />
                  <path d="M30 2 L36 6 L30 10" />
                </svg>
              )}
            </li>
          ))
        }
      </ol>

      <dl class="groups" data-reveal style="--d: 2">
        {
          skillGroups.map((group) => (
            <div class="group-row">
              <dt>
                <span>{group.label}</span>
                <span class="group-count">{String(group.skills.length).padStart(2, '0')}</span>
              </dt>
              <dd>
                <ul class="group-skills">
                  {group.skills.map((skill) => {
                    const used = usage(skill.name);
                    const usedText = used.map((u) => u.title).join(', ');
                    return (
                      <li class="tok" data-skill={skill.name} data-used={used.map((u) => u.title).join(' · ')} title={usedText ? `Used in ${usedText}` : undefined}>
                        <TechIcon name={skill.name} size={14} />
                        {skill.name}
                        {usedText && <span class="sr-only"> (used in {usedText})</span>}
                      </li>
                    );
                  })}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="tech-trace" aria-hidden="true" data-tech-trace>
        <span class="text-accent-text">›</span> <span data-tech-trace-text>Hover a technology to trace where it's used</span>
      </p>
    </div>
  </div>
</section>

<style>
  .bg-word {
    position: absolute;
    top: 0.75rem;
    right: -2rem;
    font-family: var(--font-pixel);
    font-size: clamp(5rem, 13vw, 12rem);
    line-height: 0.8;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--fg) 9%, transparent);
    pointer-events: none;
    user-select: none;
  }

  /* Profile: an unboxed spec sheet */
  .profile {
    border-top: 1px solid var(--border-strong);
  }

  .profile-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
  }

  .profile-row dt {
    padding-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .profile-row dd {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-weight: 500;
    color: var(--fg);
  }

  .profile-sub {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--fg-subtle);
  }

  .mini-title {
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .dev-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5625rem 0;
    border-bottom: 1px dashed var(--border);
    font-size: 0.9375rem;
    color: var(--fg);
    transition: translate 300ms var(--ease-out-expo);
  }

  .dev-row:hover {
    translate: 4px 0;
  }

  .sep {
    color: var(--accent-text);
  }

  /* Technical profile */
  .tech {
    display: grid;
    gap: 2.5rem;
    border-top: 1px solid var(--border-strong);
    padding-top: 2.5rem;
  }

  @media (width >= 64rem) {
    .tech {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 4rem;
      row-gap: 2rem;
    }

    .tech-head {
      grid-row: span 2;
    }
  }

  .tech-focus-label {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .tech-focus {
    margin-top: 0.5rem;
    font-family: var(--font-pixel);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--fg);
    text-shadow: 0 0 36px color-mix(in oklab, var(--accent) 18%, transparent);
  }

  .layers {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (width >= 48rem) {
    .layers {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
    }
  }

  .layer {
    position: relative;
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 0.25rem 0;
  }

  @media (width >= 48rem) {
    .layer {
      padding-right: 2.75rem;
    }
  }

  .layer-name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 1.25rem;
    color: var(--fg);
  }

  .layer-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.875rem;
  }

  .layer-link {
    display: none;
  }

  @media (width >= 48rem) {
    .layer-link {
      display: block;
      position: absolute;
      top: 0.6rem;
      right: 0.25rem;
      width: 2.25rem;
      height: 0.75rem;
      fill: none;
      stroke: var(--accent);
      stroke-width: 1.25;
      overflow: visible;
    }
  }

  .groups {
    display: flex;
    flex-direction: column;
  }

  .group-row {
    display: grid;
    gap: 0.5rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--border);
  }

  @media (width >= 40rem) {
    .group-row {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: baseline;
    }
  }

  .group-row dt {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .group-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--fg-faint);
  }

  .group-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.125rem;
  }

  .tok {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg);
    transition:
      color 200ms,
      translate 300ms var(--ease-out-expo),
      opacity 200ms;
  }

  .tok :global(svg) {
    color: var(--fg-subtle);
    transition: color 200ms;
  }

  :global([data-tech-profile][data-tracing]) .tok {
    opacity: 0.4;
  }

  :global([data-tech-profile][data-tracing]) .tok.is-lit {
    opacity: 1;
    color: var(--accent-text);
    translate: 0 -1px;
  }

  .tok.is-lit :global(svg) {
    color: var(--accent-text);
  }

  .tech-trace {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
    min-height: 1.25rem;
  }

  @media (hover: none) {
    .tech-trace {
      display: none;
    }
  }
</style>

<script>
  // Hovering a technology lights it everywhere in the profile and shows where it's used.
  const root = document.querySelector<HTMLElement>('[data-tech-profile]');
  const text = root?.querySelector<HTMLElement>('[data-tech-trace-text]');
  if (root && text && matchMedia('(hover: hover)').matches) {
    const idle = text.textContent ?? '';
    const tokens = Array.from(root.querySelectorAll<HTMLElement>('[data-skill]'));
    const usedBy = new Map<string, string>();
    tokens.forEach((t) => t.dataset.used && usedBy.set(t.dataset.skill!, t.dataset.used));
    tokens.forEach((token) => {
      token.addEventListener('pointerenter', () => {
        const name = token.dataset.skill!;
        root.dataset.tracing = '';
        tokens.forEach((t) => t.classList.toggle('is-lit', t.dataset.skill === name));
        const used = usedBy.get(name);
        text.textContent = used ? `${name} → used in ${used}` : `${name} → part of the toolkit`;
      });
      token.addEventListener('pointerleave', () => {
        delete root.dataset.tracing;
        tokens.forEach((t) => t.classList.remove('is-lit'));
        text.textContent = idle;
      });
    });
  }
</script>
